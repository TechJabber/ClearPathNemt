{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@clear-path/shared": ["packages/shared/src"],
      "@clear-path/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["packages/**/*", "services/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
